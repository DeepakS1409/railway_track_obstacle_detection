        ["r_green:2", "led_green:A", "green", ["v0"]],
        ["led_green:C", "esp:GND.1", "black", ["v10", "h-40"]],
        ["esp:17", "buzzer:2", "orange", ["v0"]],
        ["buzzer:1", "esp:GND.1", "black", ["v10", "h-60"]],
        ["esp:5V", "pir:VCC", "red", ["v20", "h-150"]],
        ["esp:GND.2", "pir:GND", "black", ["v30", "h-150"]],
        ["esp:27", "pir:OUT", "blue", ["v40", "h-150"]],
        ["esp:5V", "ultrasonic:VCC", "red", ["v-20", "h-150"]],
        ["esp:GND.2", "ultrasonic:GND", "black", ["v-30", "h-150"]],
