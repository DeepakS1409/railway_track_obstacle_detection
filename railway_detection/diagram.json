        },
        {
            "type": "wokwi-led",
            "id": "led_green",
            "top": -80,
            "left": 230,
            "attrs": { "color": "green", "label": "SAFE (Green)" }
        },
        {
            "type": "wokwi-resistor",
            "id": "r_green",
